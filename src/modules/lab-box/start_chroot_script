#!/usr/bin/env bash
########
set -x
set -e

export LC_ALL=C

source /common.sh


### Script ####

# unpack /filesystem/home/pi /home/"${BASE_USER}" "${BASE_USER}"
# unpack /filesystem/home/root /root root
# unpack /filesystem/boot /boot/firmware

# Not using apt_update_skip, forcing an update here because it does not calculate correctly
apt-get update
# in case we are building from a regular raspbian image instead of the lite one...
# remove_extra=$(remove_if_installed scratch squeak-plugins-scratch squeak-vm wolfram-engine python-minecraftpi minecraft-pi sonic-pi oracle-java8-jdk bluej libreoffice-common libreoffice-core freepats greenfoot nodered)
# echo "removing:" $remove_extra
# apt-get remove -y --purge  $remove_extra
apt-get autoremove -y

apt-get -y --allow-change-held-packages install python3 python3-virtualenv python3-dev git

echo " - Reinstall iputils-ping"
apt-get -y --force-yes install --reinstall iputils-ping


#Make sure user pi / ${BASE_USER} has access to serial ports
usermod -a -G tty "${BASE_USER}"
usermod -a -G dialout "${BASE_USER}"

usermod -aG ${BASE_USER} root


# If building against Ubuntu, make sure vcgencmd is available and pi has the rights to use it
if [ "${BASE_DISTRO}" == "ubuntu" ]; then
  apt-get -y --allow-change-held-packages install libraspberrypi-bin
  usermod -a -G video "${BASE_USER}"
fi


if [ "${LAB_BOX_PYTHON_GUI_INSTALL}" == "yes" ]
then
  echo "Installing Lab-Box Python GUI from repo ${LAB_BOX_PYTHON_GUI_REPO}"
  mkdir /home/"${BASE_USER}"/lab-box-python-gui
  cd /home/"${BASE_USER}"/lab-box-python-gui

  # Clone the Lab-Box-Python-GUI repo with the tag specified in the env variable LAB_BOX_PYTHON_GUI_TAG
  # If the env variable 'LAB_BOX_PYTHON_GUI_TAG' is empty, check the 'LAB_BOX_PYTHON_GUI_COMMIT' variable
  # When both variables are empty, checkout the latest tag
  if [ "${LAB_BOX_PYTHON_GUI_TAG}" != ""]
  then
    echo "Cloning the Lab-Box Python GUI repo with the tag: ${LAB_BOX_PYTHON_GUI_TAG}"
    git clone --depth 1 --branch $LAB_BOX_PYTHON_GUI_TAG $LAB_BOX_PYTHON_GUI_REPO .
  else
    COMMIT_SHA=""
    if [ "${LAB_BOX_PYTHON_GUI_COMMIT}" != ""]
    then
      echo "LAB_BOX_PYTHON_GUI_COMMIT is set to: ${LAB_BOX_PYTHON_GUI_COMMIT}"
      COMMIT_SHA="${LAB_BOX_PYTHON_GUI_COMMIT}"
    else
      COMMIT_SHA="$(git rev-list --tags --max-count=1)"
      echo "Fetched latest tag commit: ${COMMIT_SHA}"
    fi
    echo "Cloning the Lab-Box Python GUI repo"
    git clone $LAB_BOX_PYTHON_GUI_REPO .
    if [ "${COMMIT_SHA}" != ""]
    then
      echo "Checking out commit: ${COMMIT_SHA}"
      git checkout $COMMIT_SHA
    fi

    ls .
  fi

  # TODO: install the required python packages from the GUI repo

  # for demonstration purpose we just create a file here
  mkdir /home/"${BASE_USER}"/lab-box
  cd /home/"${BASE_USER}"/lab-box
  touch "test.txt"

fi


#unpack root in the end, so etc file are not overwritten, might need to add two roots int he future
# unpack /filesystem/root /

#####################################################################
### setup services


# update-rc.d change_password defaults
# update-rc.d change_hostname defaults


#cleanup
apt-get clean
apt-get autoremove -y
